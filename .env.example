# Public GitHub username whose owned repositories should be listed.
# Set this to your actual personal GitHub username.
GITHUB_USERNAME=

# Optional server-only GitHub token for higher API rate limits.
# Create a fine-grained token with public repository read access only.
# Never expose this as NEXT_PUBLIC_GITHUB_TOKEN.
GITHUB_TOKEN=

# Optional Umami Cloud analytics. Leave the website ID empty to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: override the script URL for a self-hosted Umami instance.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
